<Window x:Class="WpfAppDemo.Views.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppDemo.Views"
        mc:Ignorable="d"
        Title="Edit Employee" Height="450" Width="800">
    <Grid>
        <StackPanel Background="Beige" Width="200px" Height="170px" >
            <!-- Form fields -->
            <Label Content="Id"></Label>
            <TextBox Text="{Binding Employee.Id}" IsReadOnly="True" />
            <Label Content="Name"></Label>
            <TextBox Text="{Binding Employee.Name}" />
            <Button Content="Save" Command="{Binding EditCommand}" CommandParameter="{Binding Employee}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
